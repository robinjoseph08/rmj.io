---
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Nav    from '../components/Nav.astro';

interface Props {
  description?: string;
  image?: string;
  mainClass?: string;
  title?: string;
}

const {
  description = 'Robin Joseph\'s personal site',
  // Site images live under /app/assets/ so the og:image and favicon URLs from
  // the old site keep working.
  image = '/app/assets/images/og.png',
  mainClass = '',
  title
} = Astro.props;

const fullTitle = title ? `${title} | rmj.io` : 'rmj.io';
const imageUrl = new URL(image, Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;

const FAVICON_SIZES = [32, 57, 76, 96, 128, 192, 196, 228];
const APPLE_TOUCH_ICON_SIZES = [120, 152, 180];
---
<!DOCTYPE html>
<html class="h-full leading-[normal] antialiased" lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="Robin Joseph">
    <meta name="description" content={description}>
    <meta name="google-site-verification" content="qQz_VuO-tHqUQYiFBEvoRzlf0GQ0QCsFQ9Od6P29-Kg">
    <title>{fullTitle}</title>
    {FAVICON_SIZES.map((size) => <link href={`/app/assets/images/favicon-${size}.png`} rel="icon" sizes={`${size}x${size}`}>)}
    {APPLE_TOUCH_ICON_SIZES.map((size) => <link href={`/app/assets/images/favicon-${size}.png`} rel="apple-touch-icon" sizes={`${size}x${size}`}>)}
    <link href="/blog/index.xml" rel="alternate" title="robin's blog" type="application/rss+xml">
    <meta property="og:description" content={description}>
    <meta property="og:title" content={fullTitle}>
    <meta property="og:image" content={imageUrl}>
    <meta property="og:image:height" content="600">
    <meta property="og:image:width" content="1200">
    <meta property="og:type" content="website">
    <meta property="og:url" content={url}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:description" content={description}>
    <meta name="twitter:title" content={fullTitle}>
    <meta name="twitter:image" content={imageUrl}>
    <slot name="head" />
  </head>
  <body class="h-full bg-alabaster text-cod-gray">
    <div class="flex h-full flex-col">
      <Nav />
      <main class={`mx-auto w-full max-w-content grow px-[2em] py-[1em] ${mainClass}`}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
