---
const LINKS = [['/', 'rmj.io'], ['/regex/', 'regex'], ['/takuzu/', 'takuzu'], ['/blog/', 'blog']];
---
<nav>
  <div class="mx-auto flex max-w-content">
    {LINKS.map(([href, label]) => (
      <a class="flex flex-col items-center after:h-px after:w-0 after:bg-curious-blue after:transition-[width] after:duration-100 after:ease-out hover:after:w-full" href={href}>
        <span class="p-[1em]">{label}</span>
      </a>
    ))}
  </div>
</nav>
